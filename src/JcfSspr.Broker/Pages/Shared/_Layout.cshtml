<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>@ViewData["Title"] - Identity Recovery Administration</title><link rel="stylesheet" href="~/css/site.css" /></head><body><header class="topbar"><div class="wrap"><strong>Identity Recovery & Self-Service</strong><span>Internal Administration</span>@if(User.Identity?.IsAuthenticated == true){<span class="admin-user">@User.Identity.Name</span>@if(User.HasClaim("identity_recovery_local_admin","true")){<form method="post" asp-page="/Admin/LocalLogin" asp-page-handler="Logout" class="inline-form"><button type="submit" class="link-button">Sign out local admin</button></form>}}</div></header><main class="wrap main">@RenderBody()</main></body></html>

<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><title>@ViewData["Title"] - Identity Recovery Administration</title><link rel="stylesheet" href="~/css/site.css"/></head><body><header class="topbar"><div class="wrap"><strong>Identity Recovery & Self-Service</strong><span>Internal Administration</span>@if(User.Identity?.IsAuthenticated==true){<span class="admin-user">@User.Identity.Name</span>@if(User.HasClaim("identity_recovery_local_admin","true")){<form method="post" asp-page="/Admin/LocalLogin" asp-page-handler="Logout" class="inline-form"><button type="submit" class="link-button">Sign out local admin</button></form>}}</div></header>@if(User.Identity?.IsAuthenticated==true){<nav class="admin-nav"><div class="wrap"><a asp-page="/Admin/Index">Home</a><a asp-page="/Admin/Support">Support</a><a asp-page="/Admin/AssistedRegistration">Registration</a><a asp-page="/Admin/Provisioning">Provisioning</a><a asp-page="/Admin/Reviews">Reviews</a><a asp-page="/Admin/Security">Security</a><a asp-page="/Admin/Audit">Audit</a></div></nav>}<main class="wrap main">@RenderBody()</main></body></html>

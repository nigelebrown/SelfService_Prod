@page
@model JcfSspr.Broker.Pages.Admin.ProvisioningModel
@{ViewData["Title"]="Provisioning";}
<section class="card"><h1>AD provisioning</h1><p>Only server-defined profiles can be applied. Privileged and transitively privileged groups are rejected.</p>@if(!string.IsNullOrWhiteSpace(Model.StatusMessage)){<div class="alert">@Model.StatusMessage</div>}<form method="post"><label asp-for="Identifier">Find member</label><input asp-for="Identifier"/><button asp-page-handler="Search">Search</button></form>@if(Model.Subject is not null){<hr/><h2>@Model.Subject.DisplayName</h2><dl><dt>AD account</dt><dd>@Model.Subject.AdAccountName</dd><dt>Current state</dt><dd>@Model.Subject.ProvisioningState</dd><dt>Current profile</dt><dd>@Model.Subject.ProvisioningProfileCode</dd></dl><form method="post"><input asp-for="SubjectId" type="hidden" value="@Model.Subject.SubjectId"/><label asp-for="ProfileCode">Approved profile</label><select asp-for="ProfileCode"><option value="">Select</option>@foreach(var p in Model.Profiles){<option value="@p.Code">@p.Name (@p.Code)</option>}</select><div class="profile-list">@foreach(var p in Model.Profiles){<p><strong>@p.Code</strong> → @p.TargetOuDn<br/><span class="muted">Groups: @(p.GroupDns.Length==0?"Baseline only":string.Join(", ",p.GroupDns))</span></p>}</div><label asp-for="ChangeReference">Approved change / ticket reference</label><input asp-for="ChangeReference" maxlength="100"/><button asp-page-handler="Apply" type="submit">Apply reviewed profile</button></form>}</section>

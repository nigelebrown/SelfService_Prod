@page
@model JcfSspr.Broker.Pages.Admin.SecurityModel
@{ViewData["Title"]="Security controls";}
<section class="card"><h1>Security controls</h1>@if(!string.IsNullOrWhiteSpace(Model.StatusMessage)){<div class="alert">@Model.StatusMessage</div>}<form method="post"><label asp-for="Identifier">Find member</label><input asp-for="Identifier"/><button asp-page-handler="Search">Search</button></form>@if(Model.Subject is not null){<hr/><h2>@Model.Subject.DisplayName</h2><p>Self-service status: <strong>@(Model.Subject.SelfServiceDisabled?"Disabled":"Enabled")</strong></p><form method="post"><input asp-for="SubjectId" type="hidden" value="@Model.Subject.SubjectId"/><label asp-for="Reference">Security/change reference</label><input asp-for="Reference" maxlength="100"/><label asp-for="Reason">Reason</label><input asp-for="Reason" maxlength="200"/>@if(Model.Subject.SelfServiceDisabled){<button asp-page-handler="Enable" type="submit">Enable self-service</button>}else{<button asp-page-handler="Disable" type="submit">Disable self-service</button>}</form>}</section>

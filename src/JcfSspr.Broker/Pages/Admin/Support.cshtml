@page
@model JcfSspr.Broker.Pages.Admin.SupportModel
@{ViewData["Title"]="Member support";}
<section class="card"><h1>Member support</h1><p>Helpdesk actions require a support/ticket reference and are fully audited.</p>@if(!string.IsNullOrWhiteSpace(Model.StatusMessage)){<div class="alert">@Model.StatusMessage</div>}<form method="post"><label asp-for="Identifier">Find member</label><input asp-for="Identifier" autocomplete="off"/><button asp-page-handler="Search" type="submit">Search</button></form>@if(Model.Subject is not null){<hr/><div class="profile-admin">@if(!string.IsNullOrWhiteSpace(Model.Subject.PhotoDataUri)){<img class="admin-photo" src="@Model.Subject.PhotoDataUri" alt="Employee profile photograph"/>}<div><h2>@Model.Subject.DisplayName</h2><dl><dt>Computer number</dt><dd>@Model.Subject.ComputerNumber</dd><dt>PIN</dt><dd>@(Model.Subject.PinLocked?"Locked":Model.Subject.PinEnrolled?"Active":"Not enrolled")</dd><dt>Authenticator</dt><dd>@(Model.Subject.AuthenticatorEnrolled?"Enrolled":"Not enrolled")</dd></dl></div></div><form method="post" class="actions"><input asp-for="SubjectId" type="hidden" value="@Model.Subject.SubjectId"/><label asp-for="SupportReference">Support / ticket reference</label><input asp-for="SupportReference" autocomplete="off" maxlength="100"/><button asp-page-handler="UnlockPin" type="submit">Unlock PIN method</button><button asp-page-handler="ResetAuthenticator" type="submit">Revoke authenticator enrollment</button></form><p><a asp-page="/Admin/AssistedRegistration" asp-route-Identifier="@Model.Subject.SubjectId">Start assisted registration</a></p>}</section>

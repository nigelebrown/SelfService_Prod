@page
@model JcfSspr.Broker.Pages.Admin.ReviewsModel
@{ViewData["Title"]="Provisioning review queue";}
<section class="card"><h1>Provisioning review queue</h1><p>Ambiguous identities and account collisions fail closed and appear here. Correct the HR/AD condition before retrying; the portal will not guess.</p>@if(!string.IsNullOrWhiteSpace(Model.StatusMessage)){<div class="alert">@Model.StatusMessage</div>}<div class="table-wrap"><table><thead><tr><th>Member</th><th>Reason</th><th>Created</th><th>Action</th></tr></thead><tbody>@foreach(var r in Model.Reviews){<tr><td><strong>@r.DisplayName</strong><br/>@r.ComputerNumber<br/><span class="muted">@r.SubjectId</span></td><td>@r.ReasonCode<br/><span class="muted">@r.Details</span></td><td>@r.CreatedUtc.ToString("u")</td><td><form method="post"><input asp-for="ReviewId" type="hidden" value="@r.Id"/><input asp-for="ResolutionReference" placeholder="ticket / resolution note" maxlength="100"/><button asp-page-handler="Retry" type="submit">Retry safely</button><button asp-page-handler="Close" class="secondary" type="submit">Close after external resolution</button></form></td></tr>}</tbody></table></div>@if(Model.Reviews.Count==0){<p>No open reviews.</p>}</section>

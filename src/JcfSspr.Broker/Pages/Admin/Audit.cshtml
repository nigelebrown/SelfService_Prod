@page
@model JcfSspr.Broker.Pages.Admin.AuditModel
@{ViewData["Title"]="Audit history";}
<section class="card"><h1>Audit history</h1><p>Audit data is append-only to the application and database trigger. Up to 200 newest matching events are shown.</p><form method="get" class="filter-grid"><div><label asp-for="Subject">Member/account</label><input asp-for="Subject"/></div><div><label asp-for="Actor">Administrator/actor</label><input asp-for="Actor"/></div><div><label asp-for="Event">Event code</label><input asp-for="Event"/></div><div><label asp-for="Outcome">Outcome</label><input asp-for="Outcome"/></div><div><label asp-for="FromUtc">From UTC</label><input asp-for="FromUtc" type="datetime-local"/></div><div><label asp-for="ToUtc">To UTC</label><input asp-for="ToUtc" type="datetime-local"/></div><button type="submit">Search audit</button></form><div class="table-wrap"><table><thead><tr><th>UTC</th><th>Event</th><th>Actor</th><th>Member</th><th>Outcome</th><th>Correlation / Detail</th></tr></thead><tbody>@foreach(var e in Model.Events){<tr><td>@e.TimestampUtc.ToString("u")</td><td>@e.DetailCode</td><td>@e.Actor</td><td>@e.ComputerNumber<br/><span class="muted">@e.AccountName</span></td><td>@e.Outcome</td><td><code>@e.CorrelationId</code><br/><span class="muted">@e.Detail</span></td></tr>}</tbody></table></div></section>
